{
  "openapi": "3.0.0",
  "info": {
    "title": "모델 매칭 서비스 API 명세서",
    "description": "채용 과제용 Mock API 서버 명세입니다. 1,000개의 유니크한 데이터를 기반으로 개발을 진행하세요.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local API Server"
    }
  ],
  "paths": {
    "/upload": {
      "post": {
        "summary": "파일 업로드 (이미지/비디오)",
        "description": "서버의 assets 폴더에 파일을 업로드하고 접근 가능한 URL을 반환합니다.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "업로드할 파일"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "업로드 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "url": { "type": "string" },
                    "filename": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "파일이 첨부되지 않음"
          }
        }
      }
    },
    "/items": {
      "get": {
        "summary": "아이템 목록 조회 (페이징/검색/필터)",
        "parameters": [
          { "name": "_page", "in": "query", "description": "페이지 번호", "schema": { "type": "integer", "default": 1 } },
          { "name": "_limit", "in": "query", "description": "한 페이지당 개수", "schema": { "type": "integer", "default": 10 } },
          { "name": "q", "in": "query", "description": "전체 검색어 (title, description, tags 등)", "schema": { "type": "string" } },
          { "name": "status", "in": "query", "description": "상태 필터 (active, pending, rejected, archived)", "schema": { "type": "string" } },
          { "name": "category", "in": "query", "description": "카테고리 필터 (Premium, Standard, Basic, Enterprise)", "schema": { "type": "string" } },
          { "name": "tag", "in": "query", "description": "태그 필터 (정확히 일치하는 태그 검색)", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "성공", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Item" } } } } }
        }
      },
      "post": {
        "summary": "신규 아이템 생성",
        "requestBody": {
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ItemInput" } } }
        },
        "responses": { "201": { "description": "생성됨" } }
      }
    },
    "/items/{id}": {
      "get": {
        "summary": "특정 아이템 상세 조회",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "성공" } }
      },
      "patch": {
        "summary": "아이템 부분 수정 (상태 변경 등)",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "content": { "application/json": { "schema": { "type": "object", "properties": { "status": { "type": "string" } } } } }
        },
        "responses": { "200": { "description": "수정 성공" } }
      },
      "delete": {
        "summary": "아이템 삭제",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "204": { "description": "삭제 성공" } }
      }
    },
    "/items/{id}/like": {
      "patch": {
        "summary": "좋아요 수 1 증가",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "성공", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Item" } } } },
          "404": { "description": "아이템을 찾을 수 없음" }
        }
      }
    },
    "/items/{id}/view": {
      "patch": {
        "summary": "조회수 1 증가",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "성공", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Item" } } } },
          "404": { "description": "아이템을 찾을 수 없음" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Item": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "thumbnail": { "type": "string" },
          "videoUrl": { "type": "string" },
          "status": { "type": "string" },
          "category": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" },
          "likes": { "type": "integer" },
          "views": { "type": "integer" }
        }
      },
      "ItemInput": {
        "type": "object",
        "required": ["title", "status", "category"],
        "properties": {
          "title": { "type": "string" },
          "status": { "type": "string" },
          "category": { "type": "string" },
          "description": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "thumbnail": { "type": "string" },
          "videoUrl": { "type": "string" }
        }
      }
    }
  }
}